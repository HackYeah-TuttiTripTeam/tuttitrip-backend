# TuttiTrip backend settings (src/tuttitrip/shared/config/settings.py).
# Copy to `.env` and adjust. Every variable has the TUTTITRIP_ prefix and
# nested settings use a double underscore: TUTTITRIP_<GROUP>__<FIELD>.
# tests/test_settings.py fails if this file and the Settings class diverge.

# Environment name shown by /health: local, main, develop or a branch slug.
TUTTITRIP_ENVIRONMENT=local

# Allowed browser origins for CORS, as a JSON list.
TUTTITRIP_CORS_ORIGINS=["http://localhost:5173"]
# Extra allowed origins as a regex; empty disables it. Default: main/develop
# frontends and preview Workers https://tuttitrip-preview-<slug>.<sub>.workers.dev.
TUTTITRIP_CORS_ORIGIN_REGEX=^https://(tuttitrip(-develop)?\.gburek\.app|tuttitrip-preview-[a-z0-9-]+\.[a-z0-9-]+\.workers\.dev)$

# PostgreSQL. Defaults match docker-compose.yml.
TUTTITRIP_DATABASE__HOST=localhost
TUTTITRIP_DATABASE__PORT=5432
TUTTITRIP_DATABASE__USER=tuttitrip
TUTTITRIP_DATABASE__PASSWORD=tuttitrip
TUTTITRIP_DATABASE__NAME=tuttitrip
# Log every SQL statement (true/false).
TUTTITRIP_DATABASE__ECHO=false

# Auth0 tenant domain (no scheme) and the API identifier (token audience).
TUTTITRIP_AUTH0__DOMAIN=dev-yahwm2zlut2gqdry.us.auth0.com
TUTTITRIP_AUTH0__AUDIENCE=https://tuttitrip-api.gburek.app
# Access-token claim holding the user's roles (set by the Auth0 post-login
# Action); "admin" in it unlocks admin-only endpoints.
TUTTITRIP_AUTH0__ROLES_CLAIM=https://tuttitrip.gburek.app/roles
# Auth0 M2M application (scope read:users on the Management API) behind
# GET /admin/users. Empty = that endpoint answers 503. Never commit values.
TUTTITRIP_AUTH0__MANAGEMENT_CLIENT_ID=
TUTTITRIP_AUTH0__MANAGEMENT_CLIENT_SECRET=
# Timeout in seconds of every call to Auth0 (token endpoint, Management API).
TUTTITRIP_AUTH0__HTTP_TIMEOUT_SECONDS=10.0

# Pydantic AI model catalog (shared/llm). GB10 serves Qwen and the decision
# models (basal, Laya) behind one key; leave the key empty in the repo.
TUTTITRIP_LLM__GB10_BASE_URL=https://llm.gburek.app/v1
TUTTITRIP_LLM__GB10_API_KEY=
# Qwen: tuttitrip:agent (thinking, tools) and tuttitrip:chat.
TUTTITRIP_LLM__GB10_AGENT_MODEL=qwen3.8-27b
TUTTITRIP_LLM__GB10_CHAT_MODEL=qwen3.8-27b-chat
# Decision models over the System One API: tuttitrip:decide (basal, default),
# tuttitrip:decide-laya.
TUTTITRIP_LLM__BASAL_BASE_URL=https://llm.gburek.app/basal/v1
TUTTITRIP_LLM__BASAL_MODEL=basal
TUTTITRIP_LLM__LAYA_BASE_URL=https://llm.gburek.app/laya/v1
TUTTITRIP_LLM__LAYA_MODEL=laya
# OpenRouter (tuttitrip:openrouter, fallback of the Qwen agents). Empty key =
# the standard OPENROUTER_API_KEY variable.
TUTTITRIP_LLM__OPENROUTER_API_KEY=
TUTTITRIP_LLM__OPENROUTER_MODEL=google/gemini-3.8-flash
# JEV decision model on OpenRouter (tuttitrip:decide-cloud), same key.
TUTTITRIP_LLM__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TUTTITRIP_LLM__JEV_MODEL=typesafe/jev-1.13
# DBOS system database of tuttitrip-worker. Empty = the database above
# (DBOS keeps its tables in schema "dbos"). Format: postgresql://user:pass@host:port/db
TUTTITRIP_DBOS__SYSTEM_DATABASE_URL=
# DBOS application name of the worker (its DBOSConfig "name").
TUTTITRIP_DBOS__APPLICATION_NAME=tuttitrip-worker
# Version jobs are enqueued with; must equal the worker's DBOS__APPVERSION.
TUTTITRIP_DBOS__APPLICATION_VERSION=local

# Worker heartbeat age after which /health says "stale" / "missing".
# Enqueue endpoints answer 503 while the worker is "missing".
TUTTITRIP_JOBS__WORKER_STALE_AFTER_SECONDS=90
TUTTITRIP_JOBS__WORKER_MISSING_AFTER_SECONDS=600
# Start-to-close limits in seconds; DBOS cancels a workflow that runs longer.
# Plan generation and place fetching:
TUTTITRIP_JOBS__PLAN_TIMEOUT_SECONDS=900.0
# Pasted-plan parsing, offer evidence and justifications:
TUTTITRIP_JOBS__LLM_TIMEOUT_SECONDS=600.0
TUTTITRIP_JOBS__EMBEDDING_TIMEOUT_SECONDS=300.0
TUTTITRIP_JOBS__PING_TIMEOUT_SECONDS=60.0

# Jury one-link login (POST /api/v1/auth/demo). Empty TOKEN_SHA256 = route off
# (404). Link: https://tuttitrip.gburek.app/demo#t=<token>; here only the hex
# SHA-256 of that token (`printf %s "$TOKEN" | sha256sum`). The account's
# credentials belong in the host's app.env, never in the repository.
TUTTITRIP_DEMO__TOKEN_SHA256=
TUTTITRIP_DEMO__USERNAME=
TUTTITRIP_DEMO__PASSWORD=
# Auth0 application with the password-realm grant; the secret only if confidential.
TUTTITRIP_DEMO__CLIENT_ID=
TUTTITRIP_DEMO__CLIENT_SECRET=
TUTTITRIP_DEMO__REALM=Username-Password-Authentication
# true = also return a refresh token (the Auth0 application must allow it).
TUTTITRIP_DEMO__OFFLINE_ACCESS=false
# Requests per minute from one IP to the demo login (per process).
TUTTITRIP_DEMO__RATE_LIMIT_PER_MINUTE=10
# Bearer secret of POST /api/v1/internal/demo/reset (daily reset by the worker,
# never exposed by the gateway). The deploy generates it; empty = endpoint off.
TUTTITRIP_DEMO__RESET_SECRET=

# MCP server (Streamable HTTP) at /api/v1/mcp; mounted only when enabled.
TUTTITRIP_MCP__ENABLED=false
# Public URL of the endpoint without a trailing slash. It is also the Auth0 API
# identifier (token audience) of this environment, so it must match exactly.
TUTTITRIP_MCP__RESOURCE_URL=https://tuttitrip-api.gburek.app/api/v1/mcp
# Extra accepted Host header values (JSON list); the host of RESOURCE_URL is
# always accepted.
TUTTITRIP_MCP__ALLOWED_HOSTS=[]

# Demo cities (Warszawa, Gdańsk, Kraków, Berlin): a public Google Sheet that
# deploy/fetch-cities.sh downloads into the tuttitrip-cities-data volume after
# every deploy; `python -m tuttitrip.places.services.import_command` loads
# DATA_DIR/miasta.xlsx into the catalog. Empty SHEET_ID: no download, the last
# copy is used. Locally: see "Dane miast" in README.md.
TUTTITRIP_CITIES__SHEET_ID=
TUTTITRIP_CITIES__DATA_DIR=/data/cities

# Provider API keys are read by Pydantic AI under their standard names and are
# not part of Settings, e.g.:
# OPENAI_API_KEY=
